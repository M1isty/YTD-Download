@echo off
setlocal
title YTD Setup
set "YTD_SELF=%~f0"
echo.
echo   YTD Setup - unpacking, please wait...
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $m=':'+':YTD_PAYLOAD:'+':'; $s=[IO.File]::ReadAllText($env:YTD_SELF,[Text.Encoding]::ASCII); $i=$s.LastIndexOf($m); if($i -lt 0){throw 'payload not found'}; $b=[Convert]::FromBase64String($s.Substring($i+$m.Length)); $d=Join-Path $env:TEMP ('YTD_setup_'+[Guid]::NewGuid().ToString('N').Substring(0,8)); New-Item -ItemType Directory -Path $d -Force | Out-Null; $z=Join-Path $d 'payload.zip'; [IO.File]::WriteAllBytes($z,$b); Expand-Archive -LiteralPath $z -DestinationPath $d -Force; & (Join-Path $d 'install.ps1'); $c=$LASTEXITCODE; Remove-Item -LiteralPath $d -Recurse -Force -ErrorAction SilentlyContinue; exit $c"
if errorlevel 1 (
  echo.
  echo   [!] Setup did not finish. Please read the messages above.
  pause
)
endlocal
exit /b

